# pk-206 の ~/.config/recall/env（chmod 600）。このファイル自体は見本で、値は入れない。
NC_USER=kem0112
NC_PASS=（Nextcloudのアプリパスワード pk-206-voicelog）
RECALL_DISCORD_TOKEN=（Discord Developer Portal の Recall アプリのトークン）
RECALL_CHANNEL_ID=（#recall チャンネルのID）
RECALL_ALLOWED_USER_IDS=（自分のDiscordユーザーID）
# 任意: Codex のモデルの使い分け（例: gpt-6-luna）
#   light = 1件ずつの仕分け / main = 日記。未設定なら Codex の既定
# CODEX_MODEL_LIGHT=gpt-6-luna
# CODEX_EFFORT_LIGHT=low
# CODEX_MODEL_MAIN=
# CODEX_EFFORT_MAIN=
# 睡眠の判定で読む Google カレンダー（iCal 形式の非公開URL。Concierge の CONCIERGE_ICAL_URLS と同じ値。空白区切りで複数可）
RECALL_ICAL_URLS=
